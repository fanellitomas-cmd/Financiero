# =============================================================================
# Financiero — variables de entorno
# Copiar este archivo a `.env` (que ya está en .gitignore) y completar los
# valores. Todas estas variables se leen a través de `src/core/config.py::Settings`
# (pydantic-settings) — nunca con os.getenv disperso por el código
# (.cursorrules §3/§5). Ver ese archivo para los tipos y defaults exactos.
#
# Ninguna clave real debe commitearse. Este archivo es solo la plantilla.
# =============================================================================

# -----------------------------------------------------------------------------
# Nodo 1 — Polygon.io (precios/variación en tiempo real de Acciones y Cripto)
# -----------------------------------------------------------------------------
POLYGON_API_KEY=
POLYGON_BASE_URL=https://api.polygon.io

# -----------------------------------------------------------------------------
# Nodo 2 — Financial Modeling Prep (fundamentales, ratios, filings SEC 10-K/10-Q)
# -----------------------------------------------------------------------------
FMP_API_KEY=
FMP_BASE_URL=https://financialmodelingprep.com/stable

# Nodo 2 — Tavily (búsqueda de noticias/contexto web reciente)
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com

# -----------------------------------------------------------------------------
# Nodo 3 — Gemini (Google Generative Language API) — Evaluador de Escenarios
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-1.5-pro
GEMINI_TEMPERATURE=0.2
GEMINI_TIMEOUT_SECONDS=30.0

# -----------------------------------------------------------------------------
# Nodo 5 — Backend propio (registra la alerta y dispara el push del lado del
# servidor; POST {INTERNAL_BACKEND_BASE_URL}{INTERNAL_BACKEND_DISPATCH_PATH})
# -----------------------------------------------------------------------------
INTERNAL_BACKEND_BASE_URL=http://localhost:8000
INTERNAL_BACKEND_API_KEY=
INTERNAL_BACKEND_DISPATCH_PATH=/api/v1/internal/alerts/dispatch

# Nodo 5 — Firebase Cloud Messaging (push nativo directo, opcional además/en
# vez del backend propio). FCM_ACCESS_TOKEN es un token OAuth2 ya vigente —
# renovarlo vía una service account es responsabilidad de la infraestructura,
# no de este proyecto (ver docstring de src/notification/fcm_client.py).
FCM_PROJECT_ID=
FCM_ACCESS_TOKEN=
FCM_TOPIC_TEMPLATE=alerts_{ticker}

# Nodo 5 — Deep link de la app para el campo action_url del payload de push
APP_DEEP_LINK_TEMPLATE=financiero://asset/{ticker}

# -----------------------------------------------------------------------------
# Ajustes generales del pipeline (opcionales — ya tienen defaults razonables,
# descomentar solo si querés cambiarlos)
# -----------------------------------------------------------------------------
# MAX_GUARDRAIL_RETRIES=2
# MIN_DATA_COMPLETENESS_PCT_HIGH_CONFIDENCE=80.0
# MIN_DATA_COMPLETENESS_PCT_MEDIUM_CONFIDENCE=60.0
# REQUEST_TIMEOUT_SECONDS=15.0
# INGESTION_MAX_RETRY_ATTEMPTS=3
# INGESTION_RETRY_BACKOFF_BASE_SECONDS=1.0

# =============================================================================
# API backend (app/) — FastAPI + SQLAlchemy + JWT
# Estas variables se leen a través de `app/core/config.py::AppSettings`, un
# archivo de configuración separado del `Settings` del motor LangGraph (§3/§5).
# =============================================================================

# Base de datos (SQLite async por default para desarrollo local; en producción
# usar Postgres con un driver async, ej. postgresql+asyncpg://...)
# `development` (default) o `production`. En `production` el arranque FALLA si algo quedó en su
# default de desarrollo — ver `AppSettings.production_problems()` y DEPLOY.md.
ENVIRONMENT=development

# En Cloud Run el disco es efímero: SQLite ahí pierde usuarios y notas en cada reinicio. Con Cloud SQL
# la conexión va por socket unix:
#   postgresql+asyncpg://USUARIO:PASS@/BASE?host=/cloudsql/PROYECTO:REGION:INSTANCIA
DATABASE_URL=sqlite+aiosqlite:///./financiero.db
DATABASE_ECHO=false

# JWT — autenticación de /auth/register y /auth/login
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# API Key interna — protege POST /internal/trigger-agent (solo el Cron/Scheduler
# propio debe conocer este valor, nunca exponerlo al cliente móvil/web)
INTERNAL_API_KEY=change-me-in-production

# Código que hay que presentar para crear una cuenta. Vacío = registro ABIERTO (correcto en
# desarrollo, incorrecto en una URL pública: cualquiera que la encuentre se crea usuario y gasta tus
# llamadas a los proveedores).
#
# Es un secreto compartido, no un sistema de invitaciones: no registra quién lo usó ni expira.
# REGISTRATION_INVITE_CODE=

# Redis (Memorystore) para el límite de intentos de login. Vacío = backend en memoria, por proceso:
# alcanza en desarrollo, pero en `production` el arranque se niega sin esto porque con varias
# instancias de Cloud Run cada una limitaría por su lado (ver DEPLOY.md, paso 1b).
# REDIS_URL=redis://localhost:6379
# LOGIN_RATE_LIMIT_MAX_EMAIL_ATTEMPTS=5
# LOGIN_RATE_LIMIT_MAX_IP_ATTEMPTS=50
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=900


# Umbral de alerta por default para un WatchlistItem nuevo si el usuario no
# especifica uno (porcentaje de variación)
DEFAULT_ALERT_THRESHOLD_PCT=3.0

# Scheduler (app/services/scheduler.py) — corre el pipeline periódicamente sobre todos los
# tickers activos en las Watchlists, sin necesitar un Cron externo.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=15
# Si es true, se salta las corridas fuera de Lu-Vi 9:30-16:00 hora de Nueva York (aproximado,
# sin calendario de feriados bursátiles)
SCHEDULER_MARKET_HOURS_ONLY=false

# GET /api/v1/assets/{ticker} (Ficha on-demand): antigüedad máxima en minutos de un
# AlertHistory persistido para servirlo como cache en vez de correr el motor de nuevo
ASSET_INTELLIGENCE_MAX_AGE_MINUTES=15

# GET /api/v1/alerts (Centro de Notificaciones): tamaño de página por default
ALERT_HISTORY_DEFAULT_PAGE_SIZE=20

# GET /api/v1/tickers (catálogo de acciones): tamaño de página por default. El catálogo se
# puebla con `python -m scripts.sync_tickers` (requiere POLYGON_API_KEY), no automáticamente.
TICKER_DEFAULT_PAGE_SIZE=50

# CORS — orígenes permitidos para clientes web (el cliente Flutter en modo web, cualquier
# frontend futuro). "*" es cómodo para desarrollo; restringir a dominios concretos en
# producción, ej: CORS_ALLOWED_ORIGINS=["https://app.financiero.com"]
CORS_ALLOWED_ORIGINS=["*"]
